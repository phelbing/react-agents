{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(npm run:*)",
      "Bash(npm audit:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx vitest run:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(npm publish:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
